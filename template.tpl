const sendHttpRequest = require('sendHttpRequest');
const getAllEventData = require('getAllEventData');
const getEventData = require('getEventData');
const makeString = require('makeString');
const getType = require('getType');
const JSON = require('JSON');
const logToConsole = require('logToConsole');
const getContainerVersion = require('getContainerVersion');
const sha256Sync = require('sha256Sync');
const createRegex = require('createRegex');
const testRegex = require('testRegex');
const generateRandom = require('generateRandom');
const getTimestampMillis = require('getTimestampMillis');
const containerVersion = getContainerVersion();
const isLoggingEnabled = containerVersion.debugMode;

const EMAIL_REGEX = createRegex('(?:[a-z0-9!#$%&\'*+/=?^\\`{|}~-]+(?:\\.[a-z0-9!#$%&\'*+/=?^_\\`{|}~-]+)*|"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*")@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-z0-9-]*[a-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])', 'i');
const PHONE_REGEX = createRegex('^\\+[1-9]\\d{1,14}$', '');
const SHA256_REGEX = createRegex('^[a-fA-F0-9]{64}$', '');

const ENDPOINT = 'https://api.oneviewhub.com/v1/events';
const API_VERSION = '2026-05-11';
const TEMPLATE_VERSION = '2.3.0';
const USER_AGENT = 'sGTM/' + TEMPLATE_VERSION;
const TIMEOUT_MS = 1500;
const OMIT_PLAINTEXT_PII = true;

/* ------------------------------------------------
   Found a bug or want to contribute?

   Submit issues or pull requests at:
   https://github.com/oneviewhub/gtm-server-tag
-------------------------------------------------- */

// ----------------------------
// Event Source
// ----------------------------

var eventSource = makeString(data.eventSource);

// ----------------------------
// Event Data
// ----------------------------

var eventData = getAllEventData();


if (eventSource === 'WEB') {
	if (data.clientId) eventData.client_id = makeString(data.clientId);
	if (data.sessionId) eventData.session_id = makeString(data.sessionId);
	if (data.pageLocation) eventData.page_location = makeString(data.pageLocation);
	if (data.pageReferrer) eventData.page_referrer = makeString(data.pageReferrer);
	if (data.userAgent) eventData.user_agent = makeString(data.userAgent);
}

// ----------------------------
// Idempotency Key
// ----------------------------

var idempotencyKey = (function() {
	if (data.idempotencyKey) {
		var explicit = makeString(data.idempotencyKey).trim();
		if (explicit !== '') return explicit;
	}

	var random = makeString(generateRandom(0, 2147483647));
	var timestamp = makeString(getTimestampMillis());
	var fingerprint = sha256Sync(JSON.stringify(eventData), {
		outputEncoding: 'hex'
	});

	return random + '#' + timestamp + '#' + fingerprint;
})();

// ----------------------------
// Consent
// ----------------------------

var fallbackConsentMode = extractConsentMode();

// ----------------------------
// Identifiers
// ----------------------------

var identifiers = buildIdentifiers(data.dataComplex);

// ----------------------------
// Request Payload
// ----------------------------

var postBodyData = {
	event_name: getEventData('event_name') || 'unknown',
	event_source: eventSource,
	event_data: eventData,
	event_metadata: {
		idempotency_key: idempotencyKey,
		identifiers: identifiers,
		consent: {
			analytics_storage: handleConsent(data.analyticsStorage, fallbackConsentMode.analytics_storage),
			ad_storage: handleConsent(data.adStorage, fallbackConsentMode.ad_storage),
			ad_user_data: handleConsent(data.adUserData, fallbackConsentMode.ad_user_data),
			ad_personalization: handleConsent(data.adPersonalization, fallbackConsentMode.ad_personalization),
		},
	},
};

// ----------------------------
// PII Hashing & Removal
// ----------------------------

var user = postBodyData.event_data.user_data;
if (user) {
	user.sha256_email_address = hashEmail(user.email_address, 'STANDARD');
	user.sha256_phone_number = hashPhone(user.phone_number, 'E.164');

	if (OMIT_PLAINTEXT_PII) {
		user.email_address = undefined;
		user.phone_number = undefined;
	}

	var addr = user.address;
	if (addr) {
		addr.sha256_first_name = hashName(addr.first_name);
		addr.sha256_last_name = hashName(addr.last_name);

		if (OMIT_PLAINTEXT_PII) {
			addr.first_name = undefined;
			addr.last_name = undefined;
		}
	}
}

// ----------------------------
// Request
// ----------------------------

if (isLoggingEnabled) {
	logToConsole(
		JSON.stringify({
			Name: 'OneViewEvent',
			Type: 'Request',
			RequestMethod: 'POST',
			RequestUrl: ENDPOINT,
			RequestBody: postBodyData
		})
	);
}

sendHttpRequest(
	ENDPOINT,
	function(statusCode, headers, body) {
		if (isLoggingEnabled) {
			logToConsole(
				JSON.stringify({
					Name: 'OneViewEvent',
					Type: 'Response',
					ResponseStatusCode: statusCode,
					ResponseHeaders: headers,
					ResponseBody: body,
				})
			);
		}

		if (statusCode >= 200 && statusCode < 300) {
			data.gtmOnSuccess();
		} else {
			data.gtmOnFailure();
		}
	}, {
		headers: {
			'Content-Type': 'application/json',
			'Authorization': 'Bearer ' + makeString(data.apiKey),
			'API-Version': API_VERSION,
			'User-Agent': USER_AGENT,
		},
		method: 'POST',
		timeout: TIMEOUT_MS,
	},
	JSON.stringify([postBodyData])
);

// ----------------------------
// Identifier Builder
// ----------------------------

function buildIdentifiers(tableData) {
	var identifiers = {};
	if (!tableData) return identifiers;

	var i;
	for (i = 0; i < tableData.length; i++) {
		var alias = tableData[i];

		switch (alias.type) {
			case 'email':
				var hashedEmail = hashEmail(alias.value, 'STANDARD');
				if (hashedEmail !== undefined) {
					identifiers.email = {
						sha256_email: hashedEmail,
						sha256_canonical: hashEmail(alias.value, 'CANONICAL'),
					};
				}
				break;

			case 'phone':
				var hashedPhone = hashPhone(alias.value, 'E.164');
				if (hashedPhone !== undefined) {
					identifiers.phone = {
						sha256_e164: hashedPhone,
						sha256_e164_numeric: hashPhone(alias.value, 'NUMERIC'),
					};
				}
				break;

			case 'user':
				var userId = noHash(alias.value);
				if (userId !== undefined) {
					identifiers.user = userId;
				}
				break;

			case 'organization':
				var orgId = noHash(alias.value);
				if (orgId !== undefined) {
					identifiers.organization = orgId;
				}
				break;

			default:
				break;
		}
	}

	return identifiers;
}

// ----------------------------
// Hashing Helpers
// ----------------------------

function hashEmail(email, format) {
	if (getType(email) !== 'string' || !testRegex(EMAIL_REGEX, email)) return undefined;

	const matchedEmail = email.match(EMAIL_REGEX).toString();
	const standardEmail = matchedEmail.trim().toLowerCase();

	const standardEmailComps = standardEmail.split('@');

	if (format === 'CANONICAL') {
		const localPart = standardEmailComps[0];
		const domain = standardEmailComps[1];

		switch (domain) {
			case 'gmail.com':
			case 'googlemail.com': {
				const canonicalEmailDotless = localPart
					.replace(createRegex('\\+.+', 'gi'), '') // Stripping subaddress
					.replace(createRegex('\\.', 'g'), '')
					.concat('@')
					.concat(domain);
				return sha256Sync(canonicalEmailDotless, {
					outputEncoding: 'hex'
				});
			}
				
			default: 
				return undefined;
		}
	}

	return sha256Sync(standardEmail, {
		outputEncoding: 'hex'
	});
}

function hashPhone(phone, format) {
	if (getType(phone) !== 'string') return undefined;

	phone = phone.replace(createRegex('[\\s\\-\\(\\)]', 'g'), '');

	if (!testRegex(PHONE_REGEX, phone)) return undefined;
	return sha256Sync(format === 'NUMERIC' ? phone.slice(1) : phone, {
		outputEncoding: 'hex'
	});
}

function hashName(name) {
	if (getType(name) !== 'string' || testRegex(SHA256_REGEX, name) || name.trim() === '') return undefined;
	return sha256Sync(name.trim().toLowerCase(), {
		outputEncoding: 'hex'
	});
}

function noHash(value) {
	if (getType(value) !== 'string' || testRegex(SHA256_REGEX, value) || value.trim() === '') return undefined;
	return value;
}

// ----------------------------
// Consent Helpers
// ----------------------------

function handleConsent(explicitConsent, fallbackConsent) {
	var type = getType(explicitConsent);

	if (type === 'boolean') return explicitConsent ? 'GRANTED' : 'DENIED';

	if (type === 'number') {
		if (explicitConsent === 1) return 'GRANTED';
		if (explicitConsent === 0) return 'DENIED';
	}

	if (type === 'string') {
		var consentString = explicitConsent.trim().toLowerCase();
		if (consentString === 'undefined' || consentString === '' || consentString === 'inherit' || consentString === 'null') {
			return fallbackConsent;
		}
		if (consentString === 'true' || consentString === 'granted') {
			return 'GRANTED';
		}
		if (consentString === 'false' || consentString === 'denied') {
			return 'DENIED';
		}
	}

	return fallbackConsent;
}

function extractConsentMode() {
	var gcdLocation1 = getEventData('x-sst-system_properties.gcd');
	var gcdLocation2 = getEventData('x-ga-gcd');

	function parseGcdConsentString(consentSignals) {
		if (consentSignals.length < 8) {
			return {
				ad_storage: 'UNSPECIFIED',
				analytics_storage: 'UNSPECIFIED',
				ad_user_data: 'UNSPECIFIED',
				ad_personalization: 'UNSPECIFIED',
			};
		}

		function determineConsentStatus(value) {
			switch (value) {
				case 't':
					return 'GRANTED';
				case 'r':
					return 'GRANTED';
				case 'n':
					return 'GRANTED';
				case 'v':
					return 'GRANTED';
				case 'p':
					return 'DENIED';
				case 'q':
					return 'DENIED';
				case 'm':
					return 'DENIED';
				case 'u':
					return 'DENIED';
				case 'l':
					return 'UNSPECIFIED';
				default:
					return 'UNSPECIFIED';
			}
		}

		return {
			ad_storage: determineConsentStatus(consentSignals[2]),
			analytics_storage: determineConsentStatus(consentSignals[4]),
			ad_user_data: determineConsentStatus(consentSignals[6]),
			ad_personalization: determineConsentStatus(consentSignals[8]),
		};
	}

	var gcd = (function() {
		if (getType(gcdLocation1) === 'string' && gcdLocation1 !== '') {
			return gcdLocation1;
		} else if (getType(gcdLocation2) === 'string' && gcdLocation2 !== '') {
			return gcdLocation2;
		} else {
			return undefined;
		}
	})();

	function parseGcsConsentString(consentString) {
		if (consentString.length !== 4) {
			return {
				ad_storage: 'UNSPECIFIED',
				analytics_storage: 'UNSPECIFIED',
				ad_user_data: 'UNSPECIFIED',
				ad_personalization: 'UNSPECIFIED',
			};
		}

		var adStorageValue = consentString.substring(2, 3);
		var analyticsStorageValue = consentString.substring(3, 4);

		function determineConsentStatus(value) {
			switch (value) {
				case '1':
					return 'GRANTED';
				case '0':
					return 'DENIED';
				default:
					return 'UNSPECIFIED';
			}
		}

		return {
			ad_storage: determineConsentStatus(adStorageValue),
			analytics_storage: determineConsentStatus(analyticsStorageValue),
			ad_user_data: 'UNSPECIFIED',
			ad_personalization: 'UNSPECIFIED',
		};
	}

	var gcsLocation1 = getEventData('x-ga-gcs');
	var gcs = (function() {
		if (getType(gcsLocation1) === 'string' && gcsLocation1 !== '') {
			return gcsLocation1;
		} else {
			return undefined;
		}
	})();

	var output = (function() {
		if (getType(gcd) === 'string') {
			return parseGcdConsentString(gcd);
		} else if (getType(gcs) === 'string') {
			return parseGcsConsentString(gcs);
		} else {
			return {
				ad_storage: 'UNSPECIFIED',
				analytics_storage: 'UNSPECIFIED',
				ad_user_data: 'UNSPECIFIED',
				ad_personalization: 'UNSPECIFIED',
			};
		}
	})();

	return output;
}


